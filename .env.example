# =============================================================================
# Copy this file to .env and fill in the real values. .env is gitignored --
# never commit it, and never put a real key in this file.
#
# The app, the CNN and the BiomedCLIP probe work without any key; it is only
# needed for the VLM discovery and the zero-shot VLM benchmark.
# Get a free key at https://build.nvidia.com
#
# Comments sit above each line rather than inline: python-dotenv strips
# trailing "# ..." comments, but `source .env` does not.
# =============================================================================

# NVIDIA Build API key
NVIDIA_API_KEY=nvapi-your-key-here

# OpenAI-compatible endpoint used for chat completions
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Vision-language model used for the zero-shot benchmark
# (chosen from the candidates in outputs/results/vlm_discovery.json)
NVIDIA_VLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
