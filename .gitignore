# Secrets
.env

# Local working notes and prompts for the coding assistant (kept out of the public repo)
CLAUDE.md
docs/claude-code-prompt*.md

# Dataset (read-only, never committed)
archive/
data/

# Environment and tool caches
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/
.gradio/

# OS
.DS_Store

# Resume state (weights + optimizer, ~3x the model size); best.pth IS committed
outputs/checkpoints/last.pt

# Cached encoder embeddings, index and text cache; only the summary JSONs are committed
outputs/results/embeddings/*
!outputs/results/embeddings/*.json
